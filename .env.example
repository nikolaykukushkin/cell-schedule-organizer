# GitHub token for pushing schedule summaries to the lab notebook repo
# Create a fine-grained token at https://github.com/settings/tokens?type=beta
# Needs: Contents (read & write) permission on the target repo
GITHUB_TOKEN=ghp_your_token_here

# Target repo for inbox/ schedule files (default: nikolaykukushkin/experimental-data-analysis)
GITHUB_REPO=nikolaykukushkin/experimental-data-analysis

# Branch to commit to (default: main)
GITHUB_BRANCH=main
